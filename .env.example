# Google OAuth Credentials
GOOGLE_CLIENT_ID=your-client-id-here
GOOGLE_CLIENT_SECRET=your-client-secret-here

# Session Cookie Encryption Secret
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=REPLACE_ME_WITH_RANDOM_64_BYTE_HEX

# Database Path Configuration
DATABASE_URL="file:./dev.db"

# SQLCipher Encryption Key (DO NOT COMMIT THE REAL KEY)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DB_ENCRYPTION_KEY=REPLACE_ME_WITH_RANDOM_32_BYTE_HEX

# Use real encrypted DB instead of mock in-memory DB
USE_REAL_DB=true

# Email Configuration
EMAIL_FROM=your-email@gmail.com
EMAIL_APP_PASSWORD=your-app-password-here
APP_BASE_URL=http://localhost:3000

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:5173
