# Google OAuth Credentials
GOOGLE_CLIENT_ID=your-client-id-here
GOOGLE_CLIENT_SECRET=your-client-secret-here

# Session Cookie Encryption Secret
SESSION_SECRET=a-secure-random-session-secret-key

# Database Path Configuration
DATABASE_URL="file:./dev.db"

# SQLCipher Encryption Key (DO NOT COMMIT THE REAL KEY)
DB_ENCRYPTION_KEY=my-super-secret-password

# Use real encrypted DB instead of mock in-memory DB
USE_REAL_DB=true
